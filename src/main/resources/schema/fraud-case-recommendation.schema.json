{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fraud-case-recommendation.schema.json",
  "title": "FraudCaseRecommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "classification", "riskLevel", "recommendedRoute", "confidence", "humanReviewRequired",
               "evidenceIds", "policyCitations", "missingInformation", "rationale"],
  "properties": {
    "caseId": {"type": "string"},
    "classification": {"enum": ["UNAUTHORISED_TRANSACTION", "MERCHANT_DISPUTE", "DUPLICATE_PROCESSING",
                                "SUSPICIOUS_TRANSACTION", "INSUFFICIENT_EVIDENCE", "GENUINE_TRANSACTION"]},
    "riskLevel": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "recommendedRoute": {"enum": ["FRAUD_INVESTIGATION", "DISPUTE_OPERATIONS", "PAYMENT_OPERATIONS", "MANUAL_REVIEW"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "humanReviewRequired": {"const": true},
    "evidenceIds": {"type": "array", "items": {"type": "string"}},
    "policyCitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["documentId", "version", "section", "chunkId"],
        "properties": {
          "documentId": {"type": "string"}, "version": {"type": "string"}, "section": {"type": "string"},
          "chunkId": {"type": "string"}, "score": {"type": "number"}
        }
      }
    },
    "missingInformation": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "evidenceRequests": {"type": "array", "items": {"type": "string"}},
    "ruleIds": {"type": "array", "items": {"type": "string"}},
    "toolTraceIds": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "maxLength": 1200}
  }
}
